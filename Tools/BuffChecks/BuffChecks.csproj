<Project>
  <PropertyGroup><BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/../../Temp/BuffChecks/obj/</BaseIntermediateOutputPath></PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
